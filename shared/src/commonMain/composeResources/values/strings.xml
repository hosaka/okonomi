<resources>
    <string name="app_name">okonomi</string>
    <string name="common_word_badge">common</string>
    <string name="home_search_label">Search</string>
    <string name="home_favourites_label">Favourites</string>
    <string name="home_settings_label">Settings</string>
    <string name="search_placeholder">Search</string>
    <string name="search_clear">Clear</string>
    <string name="search_no_results">No results</string>
    <!-- The overflow menu on the search field, and the one setting in
         it. "Names" rather than "Person names": the database holds
         nothing else, since dictgen drops the places and companies. -->
    <string name="search_options">Search options</string>
    <string name="search_names_toggle">Names</string>
    <!-- Chips on a name row. JMnedict's own DTD expansions ("family or
         surname", "given name or forename, gender not specified") are
         sentences rather than labels, so the four person-name codes get
         short forms of their own here; the sense chips elsewhere still
         resolve through tag_label.
         All four are noun phrases on purpose. The spec named these
         chips "surname / given name / fem / masc", but shipping two
         English words beside two raw JMnedict codes reads as an
         oversight on the row; "female name" and "male name" say the
         same thing in the same register. A fem row usually carries no
         "given name" chip beside it, so "female" alone would not say
         what kind of thing it is. -->
    <string name="name_type_surname">surname</string>
    <string name="name_type_given">given name</string>
    <string name="name_type_fem">female name</string>
    <string name="name_type_masc">male name</string>
    <string name="search_results_fallback">No exact matches — showing the closest entries</string>
    <string name="search_error">Search is unavailable right now. Keep typing to retry.</string>
    <!-- The footer under the last row of a list that pages: shown while
         a further page is on its way, and when one failed to arrive. A
         list with nothing further behind it shows neither. -->
    <string name="paging_more_failed">More results could not be loaded</string>
    <string name="paging_more_loading">Loading more</string>
    <string name="paging_retry">Try again</string>
    <string name="entry_back">Back</string>
    <string name="entry_tab_word">Word</string>
    <string name="entry_tab_kanji">Kanji</string>
    <string name="entry_tab_forms">Forms</string>
    <string name="entry_tab_phrases">Phrases</string>
    <string name="entry_section_reading">Reading</string>
    <string name="entry_section_english">English</string>
    <string name="entry_alternate_forms">also written %1$s</string>
    <string name="entry_restriction">only applies to %1$s</string>
    <string name="entry_error">This entry could not be loaded</string>
    <string name="entry_retry">Try again</string>
    <!-- The save button on the entry view. One label with a spoken
         state, not two labels: a control whose name changes under the
         reader's thumb is a different control every time they reach for
         it. "Word" rather than "entry" because that is what the reader
         thinks they are keeping. -->
    <string name="entry_save">Save word</string>
    <string name="entry_saved">Saved</string>
    <string name="entry_unsaved">Not saved</string>
    <string name="entry_kanji_section_on">On</string>
    <string name="entry_kanji_section_kun">Kun</string>
    <string name="entry_kanji_section_name">Nanori</string>
    <string name="entry_kanji_section_meanings">Meanings</string>
    <string name="entry_kanji_section_radical">Radicals</string>
    <!-- The value is kanjidic2's former four-level scale, where 1 is
         the most advanced - the inverse of the modern N5-N1 intuition,
         and not faithfully convertible to it. Alex chose to show it
         unmapped and unqualified: render the stored number as it
         stands, and do NOT translate it into an N-level. -->
    <string name="entry_kanji_jlpt">JLPT %1$d</string>
    <string name="entry_kanji_grade">Grade %1$d</string>
    <string name="entry_kanji_frequency">Frequency #%1$d</string>
    <string name="entry_kanji_stroke_order">Stroke order</string>
    <string name="entry_kanji_no_data">No character data for this kanji</string>
    <!-- Reached by any headword with no kanji in it, which is usually
         kana but also covers JMdict's fullwidth latin headwords. -->
    <string name="entry_kanji_none">This word has no kanji characters to show.</string>
    <string name="entry_kanji_error">The kanji for this word could not be loaded</string>
    <plurals name="entry_kanji_strokes">
        <item quantity="one">%1$d stroke</item>
        <item quantity="other">%1$d strokes</item>
    </plurals>
    <!-- Column headers and row labels of the conjugation table. Jisho's
         table shows neither romaji nor an English hint per row, so these
         labels are the reader's only guide to what a row is. -->
    <string name="entry_forms_affirmative">Affirmative</string>
    <string name="entry_forms_negative">Negative</string>
    <string name="entry_forms_row_non_past">Non-past</string>
    <string name="entry_forms_row_non_past_polite">Non-past polite</string>
    <string name="entry_forms_row_past">Past</string>
    <string name="entry_forms_row_past_polite">Past polite</string>
    <string name="entry_forms_row_te">Te-form</string>
    <string name="entry_forms_row_potential">Potential</string>
    <string name="entry_forms_row_passive">Passive</string>
    <string name="entry_forms_row_causative">Causative</string>
    <!-- The longest label, and the one the label column is sized for. -->
    <string name="entry_forms_row_causative_passive">Causative passive</string>
    <string name="entry_forms_row_imperative">Imperative</string>
    <string name="entry_forms_row_volitional">Volitional</string>
    <!-- The kana names the two conditionals apart; "Conditional" twice
         would tell the reader nothing about which is which. -->
    <string name="entry_forms_row_conditional_ba">Conditional ば</string>
    <string name="entry_forms_row_conditional_tara">Conditional たら</string>
    <string name="entry_forms_row_desiderative">Desiderative たい</string>
    <!-- A row that exists with no negative cell: the volitional's true
         negative is the literary 〜まい, so the cell shows an em dash. A
         dash announces as nothing at all, hence the spoken wording. -->
    <string name="entry_forms_no_form">no such form</string>
    <!-- One spoken sentence per row. Without it a screen reader reads
         three unrelated strings with nothing tying a form to its label
         or its column. -->
    <string name="entry_forms_row_description">%1$s. Affirmative: %2$s. Negative: %3$s.</string>
    <!-- Reached by anything with no conjugable part of speech: nouns,
         adverbs, expressions with no verb in them. -->
    <string name="entry_forms_none">This word has no forms to conjugate.</string>
    <!-- The far more common way to reach the empty state: JMdict stores
         a suru noun without its する (勉強, not 勉強する), so there is no
         inflecting tail here to show. Jisho shows no table for these
         either. -->
    <string name="entry_forms_suru">This noun becomes a verb with する. Look up する to see how it conjugates.</string>
    <string name="entry_forms_error">The forms of this word could not be loaded</string>
    <!-- The Tatoeba corpus covers about 14% of the dictionary, so this
         is the outcome for most words and has to read as a normal
         state rather than as something having gone wrong. -->
    <string name="entry_phrases_empty">No example sentences for this word yet.</string>
    <string name="entry_phrases_error">The example sentences for this word could not be loaded</string>
    <!-- The Favourites tab. The empty state has to read as a normal
         state on a fresh install, not as something having gone wrong,
         and it has to say where the button is: nothing else on this
         screen can. -->
    <string name="favourites_title">Favourites</string>
    <string name="favourites_empty">Nothing saved yet. Look a word up and tap the heart to keep it here.</string>
    <string name="favourites_error">Your saved words could not be loaded</string>
    <string name="favourites_retry">Try again</string>
