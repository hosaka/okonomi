    <!-- The value is kanjidic2's former four-level scale, where 1 is
         the most advanced - the inverse of the modern N5-N1 intuition,
         and not faithfully convertible to it. Alex chose to show it
         unmapped and unqualified: render the stored number as it
         stands, and do NOT translate it into an N-level. -->
    <string name="entry_kanji_jlpt">JLPT %1$d</string>
    <string name="entry_kanji_grade">Grade %1$d</string>
    <string name="entry_kanji_frequency">Frequency #%1$d</string>
