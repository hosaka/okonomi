CREATE TABLE kanji (
    literal TEXT PRIMARY KEY,
    grade INTEGER,
    stroke_count INTEGER NOT NULL,
    freq INTEGER,
    jlpt INTEGER
);

CREATE TABLE kanji_reading (
    kanji TEXT NOT NULL REFERENCES kanji(literal),
    type TEXT NOT NULL,
    text TEXT NOT NULL
);

CREATE INDEX kanji_reading_kanji_idx ON kanji_reading(kanji);

CREATE TABLE kanji_meaning (
    kanji TEXT NOT NULL REFERENCES kanji(literal),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL
);

CREATE INDEX kanji_meaning_kanji_idx ON kanji_meaning(kanji);

CREATE TABLE radical (
    literal TEXT PRIMARY KEY,
    stroke_count INTEGER NOT NULL
);

CREATE TABLE kanji_radical (
    kanji TEXT NOT NULL,
    radical TEXT NOT NULL REFERENCES radical(literal)
);

CREATE INDEX kanji_radical_kanji_idx ON kanji_radical(kanji);
CREATE INDEX kanji_radical_radical_idx ON kanji_radical(radical);

-- One row per character, holding every stroke of it as newline-joined
-- SVG path data in KanjiVG's own drawing order.
--
-- Not one row per stroke, deliberately. See the note on
-- kanjiReadingsForLiterals below for what happened the last time an
-- order this project needs was left to row order: 79,921 stroke rows
-- would put stroke order back under exactly that risk, and a character
-- drawn out of order is wrong in a way no reader can un-learn. A single
-- joined column cannot be resequenced by a query plan, and the Kanji
-- tab wants a whole character at once anyway.
--
-- Newline is safe as the separator: no `d` value in the KanjiVG corpus
-- contains one (verified across all 6,703 non-variant files).
CREATE TABLE kanji_stroke_order (
    literal TEXT PRIMARY KEY,
    paths TEXT NOT NULL
);

insertKanji:
INSERT INTO kanji(literal, grade, stroke_count, freq, jlpt) VALUES (?, ?, ?, ?, ?);

insertKanjiReading:
INSERT INTO kanji_reading(kanji, type, text) VALUES (?, ?, ?);

insertKanjiMeaning:
INSERT INTO kanji_meaning(kanji, ord, text) VALUES (?, ?, ?);

insertRadical:
INSERT INTO radical(literal, stroke_count) VALUES (?, ?);

insertKanjiRadical:
INSERT INTO kanji_radical(kanji, radical) VALUES (?, ?);

insertKanjiStrokeOrder:
INSERT INTO kanji_stroke_order(literal, paths) VALUES (?, ?);

kanjiCount:
SELECT COUNT(*) FROM kanji;

radicalCount:
SELECT COUNT(*) FROM radical;

kanjiStrokeOrderCount:
SELECT COUNT(*) FROM kanji_stroke_order;

-- Single-character forms. The entry view's Kanji tab uses the IN-list
-- forms below; these stay as the natural shape for the kanji detail
-- screen, which reads one literal, and are exercised today by the
-- dictgen integration test.
kanjiReadings:
SELECT type, text FROM kanji_reading WHERE kanji = :kanji;

kanjiMeanings:
SELECT text FROM kanji_meaning WHERE kanji = :kanji ORDER BY ord;

kanjiByLiteral:
SELECT literal, grade, stroke_count, freq, jlpt FROM kanji WHERE literal = :literal;

kanjiByRadical:
SELECT k.literal, k.stroke_count, k.freq
FROM kanji_radical kr
JOIN kanji k ON k.literal = kr.kanji
WHERE kr.radical = :radical;

-- The entry view's Kanji tab reads every character of one headword at
-- once; one query per table over the whole list, never one per
-- character. A literal the IN-list names but kanjidic does not carry
-- simply returns no row, which the loader renders as its own state.
kanjiForLiterals:
SELECT literal, grade, stroke_count, freq, jlpt
FROM kanji
WHERE literal IN :literals;

-- kanji_reading carries no ord column: kanjidic's order IS the row
-- order, so rowid is the only thing that preserves it, and this ORDER
-- BY is what pins it.
--
-- Left off, the row order is whatever the chosen plan happens to yield,
-- which is not stable. Measured on SQLite 3.53: the same unordered
-- query returns per-character rowid order on the shipped index set, but
-- plain rowid order across the whole table once ANALYZE has run, and
-- readings ALPHABETISED within each character -- kun before nanori
-- before on -- as soon as the plan uses an index on (kanji, type,
-- text). No error, just a silently wrong reading order.
--
-- On the shipped index set the plan for this query is a plain index
-- search with no temp B-tree, so pinning the order costs nothing today.
-- Adding a (kanji, type, text) index later would introduce one, which
-- is the trade this ORDER BY makes deliberately.
kanjiReadingsForLiterals:
SELECT kanji, type, text
FROM kanji_reading
WHERE kanji IN :literals
ORDER BY kanji, rowid;

kanjiMeaningsForLiterals:
SELECT kanji, ord, text
FROM kanji_meaning
WHERE kanji IN :literals
ORDER BY kanji, ord;

-- radkfile states no order over a character's radicals, so the display
-- order is fixed here: simplest radical first, ties broken by literal.
radicalsForLiterals:
SELECT kr.kanji, r.literal, r.stroke_count
FROM kanji_radical kr
JOIN radical r ON r.literal = kr.radical
WHERE kr.kanji IN :literals
ORDER BY kr.kanji, r.stroke_count, r.literal;

-- One row per literal, so there is nothing here for an ORDER BY to get
-- wrong: the stroke order is inside the value, not spread over rows.
strokeOrderForLiterals:
SELECT literal, paths
FROM kanji_stroke_order
WHERE literal IN :literals;
