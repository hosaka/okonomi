-- common_rank and is_common are denormalized from the entry's forms and
-- readings (best rank, any common) so ranking queries can order by
-- commonness without joining: the FTS pre-ranking has to break its
-- position ties before it truncates, not after.
CREATE TABLE entry (
    id INTEGER PRIMARY KEY,
    common_rank INTEGER NOT NULL DEFAULT 950,
    is_common INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE kanji_form (
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    common_rank INTEGER NOT NULL,
    is_common INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX kanji_form_text_idx ON kanji_form(text);
CREATE INDEX kanji_form_entry_idx ON kanji_form(entry_id);

CREATE TABLE reading (
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    no_kanji INTEGER NOT NULL DEFAULT 0,
    common_rank INTEGER NOT NULL,
    restrictions TEXT,
    is_common INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX reading_text_idx ON reading(text);
CREATE INDEX reading_entry_idx ON reading(entry_id);

-- pos, misc, field and dial hold comma-joined short codes that resolve
-- through tag_label; restrictions holds semicolon-joined stagk/stagr
-- values. See StoredValues.kt for the split rules.
CREATE TABLE sense (
    id INTEGER PRIMARY KEY,
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    pos TEXT,
    misc TEXT,
    field TEXT,
    dial TEXT,
    info TEXT,
    restrictions TEXT
);

CREATE INDEX sense_entry_idx ON sense(entry_id);

CREATE TABLE gloss (
    sense_id INTEGER NOT NULL REFERENCES sense(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL
);

CREATE INDEX gloss_sense_idx ON gloss(sense_id);

CREATE TABLE entry_kanji (
    kanji TEXT NOT NULL,
    entry_id INTEGER NOT NULL REFERENCES entry(id)
);

CREATE INDEX entry_kanji_kanji_idx ON entry_kanji(kanji);

insertEntry:
INSERT INTO entry(id, common_rank, is_common) VALUES (?, ?, ?);

insertKanjiForm:
INSERT INTO kanji_form(entry_id, ord, text, common_rank, is_common) VALUES (?, ?, ?, ?, ?);

insertReading:
INSERT INTO reading(entry_id, ord, text, no_kanji, common_rank, restrictions, is_common) VALUES (?, ?, ?, ?, ?, ?, ?);

insertSense:
INSERT INTO sense(id, entry_id, ord, pos, misc, field, dial, info, restrictions) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertGloss:
INSERT INTO gloss(sense_id, ord, text) VALUES (?, ?, ?);

insertEntryKanji:
INSERT INTO entry_kanji(kanji, entry_id) VALUES (?, ?);

entriesForIds:
SELECT id, common_rank, is_common
FROM entry
WHERE id IN :ids;

entryById:
SELECT id, common_rank, is_common
FROM entry
WHERE id = :id;

entryCount:
SELECT COUNT(*) FROM entry;

-- Generation only. The Tatoeba linker resolves a B-line headword to an
-- entry, which needs the whole (text -> entry) mapping in memory at
-- once; the app never scans these tables.
allEntryRanks:
SELECT id, common_rank FROM entry;

allKanjiForms:
SELECT entry_id, text FROM kanji_form ORDER BY entry_id, ord;

-- no_kanji and restrictions come along because the sentence breakdown
-- has to pick a reading that belongs to the written form it found: a
-- re_nokanji reading is not a reading of the kanji at all, and a
-- restricted one belongs only to the forms it names.
allReadings:
SELECT entry_id, text, no_kanji, restrictions FROM reading ORDER BY entry_id, ord;

glossCount:
SELECT COUNT(*) FROM gloss;

readingsForEntry:
SELECT ord, text, no_kanji, common_rank, restrictions, is_common FROM reading WHERE entry_id = :entryId ORDER BY ord;

-- The range form is BINARY-collated: unlike the removed LIKE queries,
-- ASCII letters in stored text match case-sensitively (accepted, rare).
searchReadingRangePrefix:
SELECT entry_id, text, common_rank
FROM reading
WHERE text >= :prefix AND text < :prefixEnd
ORDER BY common_rank
LIMIT :limit;

searchKanjiFormRangePrefix:
SELECT entry_id, text, common_rank
FROM kanji_form
WHERE text >= :prefix AND text < :prefixEnd
ORDER BY common_rank
LIMIT :limit;

readingsExact:
SELECT entry_id, text, common_rank
FROM reading
WHERE text IN :texts
ORDER BY common_rank
LIMIT :limit;

kanjiFormsExact:
SELECT entry_id, text, common_rank
FROM kanji_form
WHERE text IN :texts
ORDER BY common_rank
LIMIT :limit;

kanjiFormsForEntries:
SELECT entry_id, ord, text, common_rank, is_common
FROM kanji_form
WHERE entry_id IN :ids
ORDER BY entry_id, ord;

readingsForEntries:
SELECT entry_id, ord, text, common_rank, is_common
FROM reading
WHERE entry_id IN :ids
ORDER BY entry_id, ord;

sensesForEntries:
SELECT id, entry_id, ord, pos
FROM sense
WHERE entry_id IN :ids
ORDER BY entry_id, ord;

-- The entry view needs every code and note a sense carries, which the
-- search's pool-sized sensesForEntries deliberately does not select.
sensesForEntry:
SELECT id, ord, pos, misc, field, dial, info, restrictions
FROM sense
WHERE entry_id = :entryId
ORDER BY ord;

glossesForEntries:
SELECT s.entry_id, g.sense_id, g.ord, g.text
FROM gloss g
JOIN sense s ON s.id = g.sense_id
WHERE s.entry_id IN :ids
ORDER BY g.sense_id, g.ord;

wordsContainingKanji:
SELECT DISTINCT kf.text
FROM entry_kanji ek
JOIN kanji_form kf ON kf.entry_id = ek.entry_id
WHERE ek.kanji = :kanji
ORDER BY kf.common_rank
LIMIT :limit;
