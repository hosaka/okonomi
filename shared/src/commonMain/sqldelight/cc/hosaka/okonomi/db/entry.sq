-- common_rank and is_common are denormalized from the entry's forms and
-- readings (best rank, any common) so ranking queries can order by
-- commonness without joining: the FTS pre-ranking has to break its
-- position ties before it truncates, not after.
CREATE TABLE entry (
    id INTEGER PRIMARY KEY,
    common_rank INTEGER NOT NULL DEFAULT 950,
    is_common INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE kanji_form (
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    common_rank INTEGER NOT NULL,
    is_common INTEGER NOT NULL DEFAULT 0
);

-- (text, entry_id, common_rank) rather than (text) alone: see the note
-- on reading_text_idx.
CREATE INDEX kanji_form_text_idx ON kanji_form(text, entry_id, common_rank);
CREATE INDEX kanji_form_entry_idx ON kanji_form(entry_id);

CREATE TABLE reading (
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    no_kanji INTEGER NOT NULL DEFAULT 0,
    common_rank INTEGER NOT NULL,
    restrictions TEXT,
    is_common INTEGER NOT NULL DEFAULT 0
);

-- Covering, and deliberately so. Every column the prefix and exact
-- search queries read is in the index, so SQLite answers them from the
-- index alone (`USING COVERING INDEX`) instead of doing one table
-- lookup per matching row — and a hot prefix like し matches thirteen
-- thousand rows.
--
-- It REPLACES the former (text) index rather than sitting beside it:
-- text is still the leading column, so it serves everything the old one
-- did. The queries that do not use it — anything filtering on entry_id,
-- plus the generation-only full scans — go through reading_entry_idx
-- and were checked to be unaffected.
--
-- What it costs, measured on the generated file: reading_text_idx grows
-- 6.96 MB -> 8.75 MB and kanji_form_text_idx 4.44 MB -> 6.01 MB, about
-- 3.3 MB on a 213 MB database. What it buys is roughly a third off the
-- per-keystroke prefix query, which also pays back the row-per-entry
-- GROUP BY those queries need for stable paging. This is the schema
-- change Alex approved on 2026-08-25 against a standing "no schema
-- changes" constraint; see the spec's change log.
--
-- It reaches devices on DICTIONARY_FORMAT_VERSION 4, not on a schema
-- version: this project has no migration files, so SQLDelight's schema
-- version is pinned at 1 and cannot signal a DDL change. Any FURTHER
-- index or column change must bump the format version. See Pipeline.kt.
CREATE INDEX reading_text_idx ON reading(text, entry_id, common_rank);
CREATE INDEX reading_entry_idx ON reading(entry_id);

-- pos, misc, field and dial hold comma-joined short codes that resolve
-- through tag_label; restrictions holds semicolon-joined stagk/stagr
-- values. See StoredValues.kt for the split rules.
CREATE TABLE sense (
    id INTEGER PRIMARY KEY,
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    pos TEXT,
    misc TEXT,
    field TEXT,
    dial TEXT,
    info TEXT,
    restrictions TEXT
);

CREATE INDEX sense_entry_idx ON sense(entry_id);

CREATE TABLE gloss (
    sense_id INTEGER NOT NULL REFERENCES sense(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL
);

CREATE INDEX gloss_sense_idx ON gloss(sense_id);

CREATE TABLE entry_kanji (
    kanji TEXT NOT NULL,
    entry_id INTEGER NOT NULL REFERENCES entry(id)
);

CREATE INDEX entry_kanji_kanji_idx ON entry_kanji(kanji);

insertEntry:
INSERT INTO entry(id, common_rank, is_common) VALUES (?, ?, ?);

insertKanjiForm:
INSERT INTO kanji_form(entry_id, ord, text, common_rank, is_common) VALUES (?, ?, ?, ?, ?);

insertReading:
INSERT INTO reading(entry_id, ord, text, no_kanji, common_rank, restrictions, is_common) VALUES (?, ?, ?, ?, ?, ?, ?);

insertSense:
INSERT INTO sense(id, entry_id, ord, pos, misc, field, dial, info, restrictions) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertGloss:
INSERT INTO gloss(sense_id, ord, text) VALUES (?, ?, ?);

insertEntryKanji:
INSERT INTO entry_kanji(kanji, entry_id) VALUES (?, ?);

entriesForIds:
SELECT id, common_rank, is_common
FROM entry
WHERE id IN :ids;

entryById:
SELECT id, common_rank, is_common
FROM entry
WHERE id = :id;

entryCount:
SELECT COUNT(*) FROM entry;

-- Generation only. The Tatoeba linker resolves a B-line headword to an
-- entry, which needs the whole (text -> entry) mapping in memory at
-- once; the app never scans these tables.
allEntryRanks:
SELECT id, common_rank FROM entry;

allKanjiForms:
SELECT entry_id, text FROM kanji_form ORDER BY entry_id, ord;

-- no_kanji and restrictions come along because the sentence breakdown
-- has to pick a reading that belongs to the written form it found: a
-- re_nokanji reading is not a reading of the kanji at all, and a
-- restricted one belongs only to the forms it names.
allReadings:
SELECT entry_id, text, no_kanji, restrictions FROM reading ORDER BY entry_id, ord;

glossCount:
SELECT COUNT(*) FROM gloss;

readingsForEntry:
SELECT ord, text, no_kanji, common_rank, restrictions, is_common FROM reading WHERE entry_id = :entryId ORDER BY ord;

-- The range form is BINARY-collated: unlike the removed LIKE queries,
-- ASCII letters in stored text match case-sensitively (accepted, rare).
--
-- One row per *entry*, not per matching text, and a total order. Both
-- halves are what makes paging stable, and neither is optional:
--
--   * LIMIT counts rows. An entry with several readings under the same
--     prefix used to spend several of them, so fifty-one fetched rows
--     could collapse to far fewer than fifty distinct entries once the
--     Kotlin side deduplicated. Page two then fetched rows that sorted
--     *above* entries already on screen and inserted them rather than
--     appending — the reader's rows moved under their thumb. GROUP BY
--     entry_id spends one row per entry, so LIMIT counts what the
--     screen counts and page one is always a prefix of page two.
--   * ORDER BY common_rank alone is not a total order. Ties resolved by
--     whatever order the scan happened to produce, which changes with
--     the LIMIT. Appending entry_id makes the order total, so the same
--     prefix always yields the same sequence.
--
-- `text` is a bare column beside MIN(): SQLite documents that in a
-- simple MIN()/MAX() aggregate query the bare columns come from the row
-- that supplied the extreme value, so this is the text of the reading
-- that carries the entry's best rank. That guarantee is a SQLite
-- extension, not standard SQL — a different engine would be free to
-- return the text of any row in the group.
searchReadingRangePrefix:
SELECT entry_id, text, MIN(common_rank) AS common_rank
FROM reading
WHERE text >= :prefix AND text < :prefixEnd
GROUP BY entry_id
ORDER BY common_rank, entry_id
LIMIT :limit;

searchKanjiFormRangePrefix:
SELECT entry_id, text, MIN(common_rank) AS common_rank
FROM kanji_form
WHERE text >= :prefix AND text < :prefixEnd
GROUP BY entry_id
ORDER BY common_rank, entry_id
LIMIT :limit;

-- Row per matching text rather than per entry: the caller pairs each
-- row's text with the deinflection candidate that produced it, which a
-- grouped row would lose. The order is still made total (entry_id, then
-- text) so which of an entry's several matching readings arrives first
-- does not depend on the scan order, and the whole exact group is a
-- prefix of itself at a larger limit.
readingsExact:
SELECT entry_id, text, common_rank
FROM reading
WHERE text IN :texts
ORDER BY common_rank, entry_id, text
LIMIT :limit;

kanjiFormsExact:
SELECT entry_id, text, common_rank
FROM kanji_form
WHERE text IN :texts
ORDER BY common_rank, entry_id, text
LIMIT :limit;

kanjiFormsForEntries:
SELECT entry_id, ord, text, common_rank, is_common
FROM kanji_form
WHERE entry_id IN :ids
ORDER BY entry_id, ord;

-- no_kanji and restrictions come along for the same reason allReadings
-- carries them: a result row pairs a written form with a reading, and a
-- re_nokanji reading is not a reading of the kanji at all while a
-- restricted one belongs only to the forms it names. Without them 叢立ち
-- was titled with 総立ち's そうだち.
readingsForEntries:
SELECT entry_id, ord, text, no_kanji, common_rank, restrictions, is_common
FROM reading
WHERE entry_id IN :ids
ORDER BY entry_id, ord;

sensesForEntries:
SELECT id, entry_id, ord, pos
FROM sense
WHERE entry_id IN :ids
ORDER BY entry_id, ord;

-- The three queries below serve the Phrases tab's tappable-word rule,
-- which asks about a breakdown word two ways: what the entry it was
-- linked to is tagged as, and what any entry written or read exactly
-- like it is tagged as. The second question is what catches the
-- particles Tatoeba's index mislinks to homographic content words (は to
-- 葉, に to 二); see PhrasesTabState's rule for why it must be narrower
-- than the first.
--
-- Both are keyed lookups over a few hundred distinct words rather than
-- a scan: filtering a full read of sense in Kotlin would mean carrying
-- the whole part-of-speech table into memory to decide a screenful.
posForEntries:
SELECT entry_id, pos
FROM sense
WHERE entry_id IN :ids;

-- Reading and kanji form are asked separately rather than in one
-- compound select: each goes straight through its own (text, entry_id)
-- index, and the caller merges the codes of both into one set per word.
posForReadingText:
SELECT r.text, s.pos
FROM reading r
JOIN sense s ON s.entry_id = r.entry_id
WHERE r.text IN :texts;

posForKanjiFormText:
SELECT k.text, s.pos
FROM kanji_form k
JOIN sense s ON s.entry_id = k.entry_id
WHERE k.text IN :texts;

-- The entry view needs every code and note a sense carries, which the
-- search's pool-sized sensesForEntries deliberately does not select.
sensesForEntry:
SELECT id, ord, pos, misc, field, dial, info, restrictions
FROM sense
WHERE entry_id = :entryId
ORDER BY ord;

glossesForEntries:
SELECT s.entry_id, g.sense_id, g.ord, g.text
FROM gloss g
JOIN sense s ON s.id = g.sense_id
WHERE s.entry_id IN :ids
ORDER BY g.sense_id, g.ord;

wordsContainingKanji:
SELECT DISTINCT kf.text
FROM entry_kanji ek
JOIN kanji_form kf ON kf.entry_id = ek.entry_id
WHERE ek.kanji = :kanji
ORDER BY kf.common_rank
LIMIT :limit;
