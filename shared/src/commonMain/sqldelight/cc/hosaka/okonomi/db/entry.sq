CREATE TABLE entry (
    id INTEGER PRIMARY KEY
);

CREATE TABLE kanji_form (
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    common_rank INTEGER NOT NULL
);

CREATE INDEX kanji_form_text_idx ON kanji_form(text);
CREATE INDEX kanji_form_entry_idx ON kanji_form(entry_id);

CREATE TABLE reading (
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    no_kanji INTEGER NOT NULL DEFAULT 0,
    common_rank INTEGER NOT NULL,
    restrictions TEXT
);

CREATE INDEX reading_text_idx ON reading(text);
CREATE INDEX reading_entry_idx ON reading(entry_id);

CREATE TABLE sense (
    id INTEGER PRIMARY KEY,
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    ord INTEGER NOT NULL,
    pos TEXT,
    misc TEXT,
    field TEXT,
    info TEXT,
    restrictions TEXT
);

CREATE INDEX sense_entry_idx ON sense(entry_id);

CREATE TABLE gloss (
    sense_id INTEGER NOT NULL REFERENCES sense(id),
    ord INTEGER NOT NULL,
    text TEXT NOT NULL
);

CREATE INDEX gloss_sense_idx ON gloss(sense_id);

CREATE TABLE entry_kanji (
    kanji TEXT NOT NULL,
    entry_id INTEGER NOT NULL REFERENCES entry(id)
);

CREATE INDEX entry_kanji_kanji_idx ON entry_kanji(kanji);

insertEntry:
INSERT INTO entry(id) VALUES (?);

insertKanjiForm:
INSERT INTO kanji_form(entry_id, ord, text, common_rank) VALUES (?, ?, ?, ?);

insertReading:
INSERT INTO reading(entry_id, ord, text, no_kanji, common_rank, restrictions) VALUES (?, ?, ?, ?, ?, ?);

insertSense:
INSERT INTO sense(id, entry_id, ord, pos, misc, field, info, restrictions) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertGloss:
INSERT INTO gloss(sense_id, ord, text) VALUES (?, ?, ?);

insertEntryKanji:
INSERT INTO entry_kanji(kanji, entry_id) VALUES (?, ?);

entryCount:
SELECT COUNT(*) FROM entry;

glossCount:
SELECT COUNT(*) FROM gloss;

readingsForEntry:
SELECT ord, text, no_kanji, common_rank, restrictions FROM reading WHERE entry_id = :entryId ORDER BY ord;

searchReadingPrefix:
SELECT entry_id, text, common_rank FROM reading WHERE text LIKE :prefix || '%' ORDER BY common_rank LIMIT :limit;

searchKanjiFormPrefix:
SELECT entry_id, text, common_rank FROM kanji_form WHERE text LIKE :prefix || '%' ORDER BY common_rank LIMIT :limit;

wordsContainingKanji:
SELECT DISTINCT kf.text
FROM entry_kanji ek
JOIN kanji_form kf ON kf.entry_id = ek.entry_id
WHERE ek.kanji = :kanji
ORDER BY kf.common_rank
LIMIT :limit;
