-- Tatoeba example sentences, one row per usable Japanese/English pair.
--
-- breakdown is the word index the Phrases tab sets its readings from:
-- space-separated `headword(reading){surface}#entryId` words, written
-- by dictgen from Tatoeba's B-line, with each of the three annotations
-- present only where there is one.
--
-- headword is the dictionary form. Every word with kanji in it carries
-- a reading, taken from the entry it resolved to wherever the source
-- states none (the source states one for only 28% of them).
--
-- surface is how THIS sentence writes the word, and is absent when the
-- sentence writes the headword unchanged. It is what locates the word:
-- japanese is rendered verbatim with the readings over it, never
-- rebuilt out of the headwords here, so 食べる has to be found in the
-- sentence as 食べない before its reading can be carried onto it. A word
-- the scan cannot find contributes nothing and costs the sentence
-- nothing.
--
-- The entry id is what decides whether a word is tappable: the app
-- looks the linked entry's part of speech up and leaves grammar words
-- inert. It is not where a tap goes — the link can be wrong (Tatoeba
-- sends は to 葉), so a tap opens a search the reader can correct.
--
-- One column rather than per-token rows: the sentence table costs
-- 22.4 MB and the links with their two indexes 5.3 MB more, against
-- roughly 34 MB for the sentence text alone once exploded, and display
-- is a parse instead of a second query per sentence.
CREATE TABLE sentence (
    id INTEGER PRIMARY KEY,
    japanese TEXT NOT NULL,
    english TEXT NOT NULL,
    breakdown TEXT NOT NULL
);

-- Capped per entry by dictgen (SENTENCES_PER_ENTRY); ord is the display
-- order it chose (readable-length sentences first, then verified, then
-- shorter). The query below takes neither a limit nor an offset: the cap
-- is what bounds it, so one entry's whole set is at most fifty small
-- rows read through the (entry_id, ord) index without a sort. Paging is
-- a `take(limit)` in PhrasesTabStateProducer, over the loaded list —
-- what costs money there is composing a breakdown row, not reading one.
--
-- The UNIQUE constraint makes a repeated link illegal in the file
-- rather than merely prevented by a set in the generator: a sentence
-- that names one entry twice is one example, and nothing downstream
-- would notice the duplicate except the reader seeing it twice.
CREATE TABLE entry_sentence (
    entry_id INTEGER NOT NULL REFERENCES entry(id),
    sentence_id INTEGER NOT NULL REFERENCES sentence(id),
    ord INTEGER NOT NULL,
    UNIQUE(entry_id, sentence_id)
);

-- (entry_id, ord) rather than entry_id alone: it is what
-- sentencesForEntry both filters and sorts on, so the query never sorts.
CREATE INDEX entry_sentence_entry_ord_idx ON entry_sentence(entry_id, ord);

insertSentence:
INSERT INTO sentence(id, japanese, english, breakdown) VALUES (?, ?, ?, ?);

insertEntrySentence:
INSERT INTO entry_sentence(entry_id, sentence_id, ord) VALUES (?, ?, ?);

-- Generation only: a sentence no surviving link references is dead
-- weight in a file every device downloads.
deleteUnlinkedSentences:
DELETE FROM sentence WHERE id NOT IN (SELECT sentence_id FROM entry_sentence);

sentenceCount:
SELECT COUNT(*) FROM sentence;

entrySentenceCount:
SELECT COUNT(*) FROM entry_sentence;

-- The sentence id comes along as the row's stable identity: the list
-- keys on it, because two entries can show the same sentence and one
-- entry two sentences that read almost alike.
sentencesForEntry:
SELECT s.id, s.japanese, s.english, s.breakdown
FROM entry_sentence es
JOIN sentence s ON s.id = es.sentence_id
WHERE es.entry_id = :entryId
ORDER BY es.ord;
