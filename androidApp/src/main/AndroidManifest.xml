<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".OkonomiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Okonomi">
        <!-- singleTask so a link opened while okonomi is running (the
             "More in Okonomi" link on an AnkiDroid card) reaches this
             activity through onNewIntent instead of starting a second
             copy of the app inside the caller's task. -->
        <activity
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- okonomi://entry/<id>, which cards sent to AnkiDroid link to. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="entry"
                    android:scheme="okonomi" />
            </intent-filter>
        </activity>
        <!-- "Okonomi" in the text selection toolbar of every app, okonomi
             included, labelled with app_name since neither the activity
             nor the filter sets a label. The toolbar starts it expecting
             a result, and Android then puts it in the caller's task
             whatever its launch mode, so it is a trampoline with no UI
             rather than a filter on MainActivity: it forwards the
             selection to MainActivity with NEW_TASK, which honours
             singleTask, and finishes. The filter lives here alone, so the
             toolbar lists okonomi once. -->
        <activity
            android:exported="true"
            android:name=".ProcessTextActivity"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>