<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 and above. See
  backup_rules.xml: the copied dictionary is a regenerable artifact far
  larger than the backup quota, so it is excluded from both flows.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="okonomi.db" />
        <exclude domain="file" path="okonomi.db.version" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="okonomi.db" />
        <exclude domain="file" path="okonomi.db.version" />
    </device-transfer>
</data-extraction-rules>
